# Leave blank to use honest offline template script generation.
# For local AI install Ollama and run: ollama pull llama3.2:3b
SHADOW_OLLAMA_MODEL=

# OPTIONAL premium voice provider. Keep these in .env on your PC; never upload or share .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Matilda (vidIQ voice ID XrExE9yKIg1WjnnlVkGX) is only an optional
# ElevenLabs voice here if YOUR ElevenLabs account can access it.
# vidIQ credits and this API key are separate; do not assume they share quota.

# Optional owner-only automation API. Make a secret with:
# python -c "import secrets; print(secrets.token_urlsafe(36))"
# Leave unset to disable API access. NEVER put this token in an exported screenshot or chat.
SHADOW_AGENT_TOKEN=

# OPTIONAL: automatic MP4 transfer to PRIVATE S3-compatible storage (e.g. AWS S3 / Cloudflare R2).
# Create a private bucket and limited write/read-permission keys. Don't use a public bucket.
# Any temporary signed download link is a bearer link: anyone with the link can view the Short.
SHADOW_S3_BUCKET=
SHADOW_S3_REGION=us-east-1
SHADOW_S3_ENDPOINT=
SHADOW_S3_ACCESS_KEY=
SHADOW_S3_SECRET_KEY=
# Set true to start transferring each video AFTER approval (default OFF).
SHADOW_HANDOFF_AUTO_UPLOAD=false

# New v0.20 owner-only MCP server (a separate read-only service on port 8766).
# Local tests use SHADOW_AGENT_TOKEN. Direct ChatGPT MCP authentication needs OAuth.
SHADOW_MCP_AUTH_MODE=token
# To connect through a supported OAuth provider, set ALL of these first:
# SHADOW_MCP_AUTH_MODE=oauth
SHADOW_MCP_OAUTH_ISSUER=
SHADOW_MCP_OAUTH_JWKS_URL=
SHADOW_MCP_OAUTH_AUDIENCE=
SHADOW_MCP_OWNER_SUB=
SHADOW_MCP_REQUIRED_SCOPE=shadow:videos:read
SHADOW_MCP_RESOURCE_URL=

# Optional trusted release manifest URL (HTTPS). Required for automatic update checks.
# SHADOW_UPDATE_FEED=https://updates.your-domain.example/shadow-studio/latest.json
